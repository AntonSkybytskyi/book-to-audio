{
  "name": "@book-to-audio/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Request, response and event types shared by the web UI, the core API and the TTS services",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "6.0.3",
    "yaml": "^2.9.1"
  }
