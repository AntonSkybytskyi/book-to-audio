#!/bin/sh
# Sourced by the nginx image's entrypoint before it fills in the templates: the body size limit is
# MAX_UPLOAD_MB plus 1 MB for the multipart form around the file, so core's own limit answers first.
case "${MAX_UPLOAD_MB:-}" in
  "" | *[!0-9]*)
    echo "MAX_UPLOAD_MB must be a whole number of megabytes, got \"${MAX_UPLOAD_MB:-}\"" >&2
    exit 1
    ;;
esac
export NGINX_BODY_LIMIT="$((MAX_UPLOAD_MB + 1))m"
