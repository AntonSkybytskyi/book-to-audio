{
  "name": "book-to-audio",
  "version": "0.1.0",
  "private": true,
  "description": "Convert e-books (EPUB, PDF) to audiobooks",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --ignore './src/app/**' src/server/index.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/index.js",
    "benchmark": "node dist/server/benchmark/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.4",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "htmlparser2": "12.0.0",
    "jszip": "3.10.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
