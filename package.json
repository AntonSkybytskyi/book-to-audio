{
  "name": "book-to-audio",
  "version": "0.1.0",
  "private": true,
  "description": "Convert e-books (EPUB, PDF) to audiobooks",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @book-to-audio/contracts build && pnpm --recursive --parallel --stream run dev",
    "build": "pnpm --recursive run build",
    "benchmark": "pnpm --filter @book-to-audio/api benchmark",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm --recursive run typecheck",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
