{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "preserve",
    "noEmit": false,
    "incremental": false,
    "plugins": [],
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/server/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/server/testing/pool-harness.ts"]
}
